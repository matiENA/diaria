# ==============================================================================
# Variables de Entorno para Render Cloud y Local
# ==============================================================================

# 1. Credencial de Google Service Account (Pega el contenido del JSON como un string de una sola línea o multilínea)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# 2. Alternativa: Ruta al archivo local de credenciales
GOOGLE_SERVICE_ACCOUNT_FILE="./gs account/ute-logistica-firebase-adminsdk-fbsvc-04f3a4a36e.json"

# 3. Scheduler de tareas automáticas en segundo plano (true = activo en Render)
ENABLE_SCHEDULER=true

# 4. Puerto HTTP para la API de Render
PORT=10000

# 5. Zona horaria de ejecución
TZ=America/Argentina/Buenos_Aires

# 6. IDs de Hojas de Cálculo
DEFAULT_RUTEOS_ID=1-wNLgr2b1TibP_MPwA9ToF9jlH_jiPxjN0iirWbFb3o
DEFAULT_MOV_ID=14Mb5rD853zxDkaLDS-IrW-OBDTDBjuJxn_3olXeWlkc
CONF_SPREADSHEET_ID=1bK99AJp7O1jluupQeM5lsH8Gu5QfT--HXWTNzMft9tU

# 7. Alertas de Telegram (Notificaciones proactivas de fallos o tareas)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=987654321
TELEGRAM_NOTIFY_ALL=false
